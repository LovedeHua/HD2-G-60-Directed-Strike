-- User-authorized experimental native filtering; no executable-memory modifications.
local existing=rawget(_G,'G60BugholeLock')
if existing then return existing end
-- ★ 裁剪版身份：独立 _G 全局名 + 独立日志文件，与上游 G60SmartTargeting 并存不冲突
--   （但两个包的**玩法**互斥，管理器里只能启用其中一个）。
-- ★ 行为范围：只有"玩家标记了 9 个虫洞之一"才接管；其余情况 mod 完全不插手，
--   G-60 的敌人选择保持游戏原生 TargetLock。
-- ★★ 裁剪 D（本轮修 bug 的关键）：designed_targets_only 必须 **false**。
--   它为 true 时 experimental_runtime 会建 env.target_allowed = Allowlist(泰坦+弱点)，
--   而 native_minimal 的 selection_veto.plan() 第 23 行是：
--       if not excluded(r) and (not allowed or allowed(r)) then keep end
--       return {kind='search', clear_selection=true}, 'EXCLUDED_SELECTION'
--   ⇒ 任何不在 allowlist 里的选择都会被**清掉 selection + 强制搜索**。
--   allowlist 只有泰坦/冲锋者那几类 ⇒ 结果就是"G-60 只能锁大型敌人，打不了中小型"，
--   而且**虫洞同样不在名单里**，某些时序下虫洞目标也会被清掉（用户实机反馈的两个 bug）。
--   置 false ⇒ target_allowed=nil ⇒ `not allowed` 恒真 ⇒ 永不 veto ⇒ 敌人侧完全原生，
--   虫洞则只由 structure_profiles（9 个虫洞）单独决定接管。
-- ★ titan_standoff = 目标爆点距离（泰坦腹部下方几米引爆）。
--   ★★ 2026-10-05（用户拍板「泰坦方面全部改成上游 1.1」）：**0.85→2.5→1.75→2.0 那套
--      自研自适应（`titan_standoff_min`）已整段移除**；现在直接用上游的 2.5，泰坦引爆点
--      由上游 `Adaptive`（爆点 = 腹点 + 腹法线×2.5 + `surface` 区域）决定。
--
--   【为什么反转】原先把它一路压到 0.85 的**前提已被证伪**。
--   当时的理由是「爆点贴近腹部 ⇒ 伤害集中 ⇒ 才炸得死」（见下历史记录），
--   但用户 2026-10-02 用实机 + 机制纠正：
--     · 「如果手雷引爆点太靠近腹部就会炸不死」
--     · 「G60 杀死泰坦是靠**多部位**造成伤害，太靠近腹部会让**受伤部位减少**」
--   ⇒ 「离腹部更近」不是更好，而是**更差**。而自适应下限 0.85 恰好允许
--     把爆点压到**腹部下方 0.85 m** —— 正是用户后来报的
--     「偶尔会在距离腹部极近的情况下引爆 / 泰坦准备吐酸时腹部会降低导致杀不死」。
--   ⇒ 现在把下限设为 **2.0**（用户 2026-10-02 定）：
--     · **0.85** 太松 —— 允许爆点贴到腹下 0.85 m（"偶尔在离腹部极近处引爆"的来源）
--     · **1.75** 实测**仍会偶尔炸不死**（贴腹区间还是太宽）
--     · **2.5**（= 完全不许缩短）**过于严格** —— 腹部被压低时直接拒绝规划、手雷干等
--     ⇒ 最终取 **2.0**：收缩区间收窄到 2.0~2.5，只保留很小的余量
--     数学后果（`titan_route` 的不变量）：规划成功 ⇒ `p_z - standoff ≥ floor`
--     ⇒ 接近点 `under = max(p_z-3.5, floor) ≤ p_z - standoff`
--     ⇒ **任意阶段的引爆点都在腹部下方 ≥ 2.0 m**（standoff 名义值仍是 2.5，
--       只在净空受限时才收到 2.0~2.5 之间）。
--     腹部低到连 2.0 都放不下时 `titan_route` 直接**拒绝规划**，
--     我们在原地等待（见 runtime 的"净空等待"分支），腹部抬起后照常引爆。
--
--   【代价 / 回退】腹部极低的那几秒不再"贴着腹部硬炸"（那本来就炸不死），
--     代价是这一小段时间不推进（极端情况下这颗手雷会被浪费）。
--     想要更松：改回 **0.85**（旧自适应）或 **1.75**；想要更严：改成 **2.5**。
--   【历史】1.5 → 0.5 → 0.75 → 1.0 → 0.85（2026-09-30 试错）→ 2.5 → 1.75 → **2.0（2026-10-02 最终）**
--   · `titan_route` 的离地余量保持上游的 1.25 不变（该文件是逐字节守卫）
--   · 自适应在**调用方** native_titan_aim 完成，titan_route.lua 保持逐字节不变。
local state={version='@@VERSION@@-bughole',filter_enabled=false,designed_targets_only=false,titan_standoff=2.5,
    -- ★★ 2026-10-05（用户拍板「泰坦方面全部改成上游 1.1」）：恢复上游的泰坦开关。
    --   `adaptive_approach` = 上游泰坦引爆点的**最终决定者**（`Adaptive`：爆点 = 腹点 + 腹法线×2.5、
    --     到达区域 = `surface`、航路走 `Navigation` 可见性图）；`blast_regions` = 链上第二段
    --     （`BlastRoute` 的圆柱爆区）。两者上游都是 `true`。
    --   ⚠ 上游还有 `damage_regions=true` —— 那是弱点/机器人路径用的（要 `DamageField` 里有该模型
    --     才生效）。本工程 `weakpoint_profiles` 为空表、`DamageField` 无泰坦条目 ⇒ 恒为 no-op，
    --     故**不引入**（引入只会多一条永远不会走的分支）。
    --   ⚠ 同时**移除我们自研的两项**：`titan_standoff_min`（standoff 自适应 1.5~2.5）与
    --     `titan_belly_above`（腹部提前引爆余量）—— 上游都没有这两件事，且它们只在
    --     "竖直爆点"几何下才有意义（现在爆点由 `Adaptive` 决定）。
    adaptive_approach=true,blast_regions=true,
    mark_priority_enabled=false,exclusive_targets=true,marked_structures=true,
    -- ★ 吐酸泰坦接管开关（2026-09-29）
    --   本 mod 接管的���标只有两类：玩家标记的虫洞 + 吐酸泰坦。其余全部交还引擎原生
    --   （small_filter 空表 / weakpoint_profiles 空表 / designed_targets_only=false）。
    --   设为 false 可立即退回"只打虫洞"，无需回滚重装。
    --   改动点：experimental_runtime 的 has_weakpoint —— 它在 2026-09-27 的
    --   "裁剪 C"里被收窄成只认 structure_profiles，导致泰坦永远进不了接管路径
    --   （titan_route / titan_aim / titan_profile 全套代码其实一直都在）。
    titan_enabled=true,
    -- ★ 蟑龙 Dragonroach（2026-09-29）★
    --   resource=960b48a421a3faaa，weakpoint kind="thorax"，standoff=2.5。
    --   docs/TARGETS.md 记录的攻击位置："胸腔气囊下方，带 blast standoff"。
    --
    --   为什么天生适配飞行单位：
    --     · weakpoint_route 的 thorax 分支**没有地面净空检查**
    --       （只有 Impaler 的 underside 分支才有 floor 判断）
    --     · 上游源码注释原话："Dragonroach can be airborne;
    --       its root is not a terrain-height sample."
    --     ⇒ 爆点由"瞄准点 − standoff"得出，与地面无关。
    --   ⇒ 不需要新几何、不需要新路由，只需放行资源。
    --
    --   注意：用**精确哈希**匹配，不按 kind 推断 —— 按 kind 会把其它
    --   同 kind 敌人（Spore Charger 也是 head）一起放进来。
    dragonroach_enabled=true,dragonroach_resource='960b48a421a3faaa',
    -- ★ 泰坦变体开关（2026-09-29）
    --   目前登记一个：cha_strider_gloom（孢子泰坦 / Spore Burst Bile Titan）
    --     = ef04cb84d097a497，与基线 cha_strider 同属 content/fac_bugs/cha_strider/
    --   ⇒ 几何借用基线，**未经实机验证**。设为 false 可单独关掉变体、
    --     保留普通泰坦（更保守的选择）。
    --   失败是 fail-closed：titan_context 在写任何字节之前会校验身份/类/锚点，
    --   不符则记 titan_skipped，不写内存。
    titan_variants_enabled=true,
    -- ★ 引擎选择否决（2026-09-29，用户要求"G-60 不追踪运输船"）
    --   默认**开启**（按用户要求）。设为 false 立即退回"敌人侧完全原生"。
    --
    --   ⚠️ 这是本工程**唯一**一处主动干预"非本 mod 持有"的 G-60 的地方
    --      （裁剪 F 的例外）。做法：把资源放进 small_filter 的排除表 + 在
    --      take_gate 里为这一种情况放行 veto 决策 → 走 runner 的 search 动作
    --      （calls.clear + calls.orbit）清掉引擎的选择，**但不接管飞行**。
    --
    --   ⚠️ 代价（必须知情）：runner 的 search 动作在**发生部分写入之后**失败时
    --      会永久停手，本工程按既有惯例同步置 self.disabled（fail-closed）。
    --      与现有虫洞引导走的是同一套 runner，所以风险与既有路径同级。
    --
    --   ⚠️ 已加只读诊断 enemy_selection / enemy_veto 用于确认资源身份：
    --      资源哈希 98152772a72f7838 确认存在于游戏实体表，但**未能**用
    --      MurmurHash64A 反查到资源路径 ⇒ "它=运输船"未经独立验证。
    --      若日志显示它在别的东西上触发，置 false 即可。
    enemy_veto_enabled=true,
    -- ★★ 通用标记目标接管（2026-09-30，用户要求）★★
    --   除 虫洞 / 泰坦 / 泰坦变体（走各自的专门路径）外，**玩家标记的任意目标**
    --   都接管：强制 G-60 飞向它并引爆。
    --
    --   ▸ 引爆位置**由引擎决定**（calls.aim）—— 不自己算几何，符合"优先调用原生函数"。
    --   ▸ 友方排除**靠硬门槛** `calls.target_valid`（game.dll+0x8858a0 =
    --     引擎索敌系统的"能不能把它当锁定目标"判定）。引擎不锁友方 ⇒ 友方自然被排除。
    --     这与项目既有分析一致（README「追踪虫巢被拒」一节：虫洞因没有 HealthComponent
    --     被它判 false —— 本 mod 对**虫洞**才需要绕过它，通用目标不必）。
    --   ▸ 排除表（small_filter）仍然生效（运输船等）。
    --   设为 false 可完全退回"只管虫洞/泰坦/变体"。
    generic_takeover_enabled=true,
    -- ★★★ 体内爆点（2026-10-03，巨型构筑者 Bulk Fabricator）★★★
    --
    --   背景：本 mod 对"未登记目标"的既有做法是**把引爆位置交给引擎**（`calls.aim`，
    --   见 README「它做什么」表）。对**虫洞**够用 —— 虫洞的摧毁判定是**距离**
    --   （用户实测：引爆点 <4 m 即摧毁）。但**巨型构筑者不是**：
    --   用户实测「会在巨型构筑者的底部引爆，但不会对其造成伤害」，
    --   且「能摧毁的引爆点要**进入红色的通风口里面**」。
    --   ⇒ 这一类必须显式给一个**模型体内**的爆点，不能沿用虫洞那套。
    --
    --   名册见 `compat/blast_sites.lua`（目前 1 项：4232ee48e2cfd24e =
    --   content/env_cyborg/gameplay/colony_cyborg_spawner/cyborg_colony_spawner_base）。
    --   设为 false ⇒ 退回旧行为（引擎 aim）。
    blast_sites_enabled=true,
    -- ★★★ 早期导航探测（2026-10-01，用户要求"无敌人时也能炸虫洞"）★★★
    --   目的：测出 state 2/3（附近无敌人）时**能否拿到 movement 组件地址** ——
    --   这是"绕过 selection、直接用 orbit 写导航目的地"这条路的前提。
    --   · `early_nav_probe=true`  —— **纯只读**（每颗 G-60 探一次，打一行
    --     `early_nav_probe;` 日志）。零风险：不写内存、不碰 take_gate、
    --     不改变任何现有行为（allow_state3 仍为 false）。默认**开**。
    --   · `early_nav_orbit=true` —— 第二级：探测成功后额外调**一次**引擎自己的
    --     `calls.orbit` 试写 `movement+0x60`，再回读 destination 与 path_agent
    --     （日志 `early_nav_orbit;`）。
    --     ★ 2026-10-01 用户拍板开启 ★ 实测前提：state 3 探测 `result=OK` 但
    --       `path_agent=false` + `dest=0.00,0.00,0.00`（引擎压根没给目的地）⇒
    --       orbit 是**唯一的写途径**（mod 只绑了**读**内存的 API，无任何写内存 API）。
    --     安全边界：**每颗 G-60 只调一次**（按 flight_start 去重，不是每帧）；
    --       orbit 是已在 state 4 每帧调用的同一函数；但 `path_agent=false` 是新条件，
    --       最坏情况是游戏崩溃（重开即可，不写盘）。
    --   ⇒ 只看日志就能回答：早期能不能拿到 movement、orbit 在早期是否被采纳。
    --
    -- ★★ 2026-10-01 实验已做完，两个开关**归零**（结论见下，代码与开关保留备查）★★
    --
    --   实测（v0.1.4，11 颗 G-60，结果 11/11 完全一致）：
    --     early_nav_probe;state=3;result=OK;movement=…;path_agent=false;dest=0.00,0.00,0.00
    --     early_nav_orbit;state=3;ok=true;before=0,0,0;after=-189.86,-3.54,-0.96
    --                    ;changed=true;agent_before=false;agent_after=false
    --   ⇒ ① state 3 **能拿到** movement 地址（"拿不到地址"的顾虑不成立）
    --     ② `orbit` 调用成功、destination **确实被写入**（0,0,0 → 真实坐标）
    --     ③ **但 `path_agent` 始终是 false** ⇒ 引擎**没有**开始导航 ⇒ 写入无人读取
    --        ⇒ G-60 继续弹道飞行，虫洞炸不掉（用户实测确认）
    --
    --   机制结论：**state 2/3 的 G-60 处于弹道飞行模式（无 path_agent），
    --   既不读 selection（setter 已证）也不读导航目的地（orbit 本次证）** ——
    --   两者失效是**同一个原因**：引擎还没把它从弹道切到导航。
    --   ⇒ 在早期 state 里改任何"目标数据"都无效；除非能让引擎**自己**建立寻路代理。
    --   ⇒ 现有 6 个原生函数（clear/orbit/target_valid/aim/explode/remove）**已全部试尽**。
    --   剩下的唯一路径是逆向 game.dll 找"分配目标 / 状态转换 / 建立 path_agent"的函数
    --   （磁盘那份有加密壳 ⇒ 需 dump 运行时镜像），成本高，未做。
    --
    --   要重启实验：把下面两个值改回 true 即可（early_nav_orbit 是**写操作**，谨慎）。
    early_nav_probe=false,early_nav_orbit=false,
    -- ★★ 转阶段 / 换目标探针（2026-10-07，用户要求，**纯只读**）★★
    --   问："引擎在什么条件下把 G-60 转向索敌 / 丢掉目标？"
    --   这正对着上面那条未解问题（"无敌人时 G-60 不被驱动，受 state 约束"）。
    --   为什么先用探针而不是直接逆向：定位"分配目标 / 状态转换 / path_agent"
    --   那几个函数要 dump 运行时镜像（磁盘那份有加密壳），成本高；
    --   而**转阶段的后果是可观测的**（state 回退 / selection_id 被清成哨兵 /
    --   selection_flag 归零 / selection_resource 变化 / candidate_source 变化），
    --   这五项都在每帧已读的 match 行上 ⇒ 探针零新增内存读、零写操作。
    --   行为：每颗 G-60 只在**元组变化**时打一行 `sel_probe;`（首次也打），
    --        全局上限 4000 行。设 false 即完全静默。
    --   ⇒ 拿到"转阶段发生的帧 + 前后字段值"之后，才谈得上判断触发条件
    --     是「候选表空」「标记失效」「距敌人过远」还是「超时」中的哪一类。
    sel_probe_enabled=true,
    -- ★★ 代码探针（2026-10-07，用户拍板"路线 A"）★★
    --   目的：把**运行时展开后的引擎机器码**取出来离线反汇编，回答
    --   "引擎凭什么认为某个东西可以成为合法锁定目标"
    --   （本工程早已记录：`target_valid` = game.dll+0x8858a0 就是那条判据；
    --     "让虫巢成为合法目标"那条路的结论就是判据写在 game.dll 里）。
    --   为什么不用 dump 整个镜像：磁盘那份确实被保护（实测 —— 全文件搜不到已知
    --   入口签名、节熵 8.00、虚拟 71 MB vs 原始 14.8 MB、`.winlice` 节只有虚拟
    --   尺寸），但**不需要它**：地址早已逆向出来，直接读运行时那几个 RVA 即可。
    --   整镜像 dump + PE 修复是数量级更大的动作，而这里只要几 KB。
    --   ⚠ 这不是新能力：**本段上面 88 条 game.dll 签名校验本来就是
    --     `read(base+RVA,N)` 读代码字节做比对**；这里只把"断言相等"换成"打印"。
    --   ⇒ 纯只读、不写内存、不扩大能力面；一次性（每次启动一轮，共约 5 KB 日志）。
    --   ⚠ 必须 pcall 包住：探针失败**绝不能**让 mod 启动失败（那会停用整个包）。
    --   ★ 2026-10-09 **改为 false（默认关闭）**：这一段的使命已经完成——
    --     · state-3 转换 / seek 函数 / 候选分数来源**全部读出来了**（见 README 与工作日志）；
    --     · 结论已固化进 force_lock（无敌人时强制提升 state=4，实机 5/5 炸毁虫洞）。
    --   为什么必须关掉：本段含 7 个代码 dump + 调用者扫描 + 模式扫描，**每次启动约 55 KB**，
    --     而日志**总量上限 256 KB** ⇒ 长时间一局会把后面真正要看的诊断挤掉（静默截断）。
    --   需要继续逆向时把它置 true 即可（一键恢复全部 dump）。
    code_probe_enabled=false,
    -- ★★ 目标字段探针（2026-10-08）：被标记目标的 f08/f0c/f4c + target_valid 结论 ★★
    --   与 code_probe 配对：反汇编说明"判据长什么样"，字段探针给出"实际值是什么" ——
    --   两者合起来才能定位到底是哪一条判据把虫洞挡掉的。
    --   三个偏移来自 target_valid / category_mask 的反汇编（不是猜的）：
    --     +0x08 f08 参与全局集合查询、喂给 0x4a9710 取 bit25 标志
    --     +0x0c f0c 喂给间接调用与 0x13e1b50（返回值 >=1 即拒）
    --     +0x4c f4c category_mask 用它做位测试（实体类别掩码）
    --   ⚠ 纯只读、按 (来源,id) 去重；设 false 即静默。
    target_fields_probe=true,
    -- ★★ "空白标记"探查（2026-10-01，**只读**）★★
    --   用户问：「无目标的空白标记（ping 到空地）是否也能接管？」
    --   第一步先回答客观问题：**ping 空地时那个 88 字节的槽里有没有世界坐标**
    --   （本 mod 只解出了 +0x10/14/18/20 四个字段，其余 ~68 字节从没看过）。
    --   行为：**只在读不到实体**（NO_ENTITY_MARK）时把整槽 dump 出来
    --        （hex 全量 + 扫描出的"疑似坐标三元组"），每槽一次。
    --   ⇒ 纯读、零风险；ping 到实体时完全不产生日志。
    --   ⚠ 注意：这**不解决**"无敌人时 G-60 不被驱动"的问题（那受 state 约束），
    --     它只回答"玩家 ping 的位置能不能被读到"。
    ping_slot_dump=true,
    -- ★★ "空白标记"位置暴露（2026-10-01，**只读**）★★
    --   现状：玩家 ping **空地**时本 mod 只打 `NO_ENTITY_MARK` 然后忽略；但实测证明
    --   那个槽里**带世界坐标**（`+0x04` float3；8 槽三边定位自洽、残差 ~0.7m RMS；
    --   两次 ping 的坐标间距 37.3m 与"走开约 30m 再 ping"吻合）。
    --   本开关把它打到日志（`point_marker;slot=..;pos=..;dist=..`）——
    --   这是"有敌人时 ping 一个位置 ⇒ G-60 飞过去炸（指哪打哪）"的**前置验证**：
    --   先确认位置能走到决策层，再谈用它引导。
    --   ⚠ 纯诊断：**不改变任何现有行为**（`observe()` 的返回仍只含"有实体的标记"）。
    --   置 false 即完全静默。
    point_marker_enabled=true,
    -- ★★ 点目标：ping 一个位置 ⇒ G-60 飞过去炸（"指哪打哪"，2026-10-01 用户要求）★★
    --   原理：玩家 ping **空地** 时，ping 槽里带世界坐标（见 point_marker_enabled）。
    --   开启后，本 mod 会把那个坐标写成**点目标选择**（`native_arrival` 的
    --   `options.point_target`，与泰坦路径同款写法：invalid_id + 坐标），
    --   让引擎把 G-60 飞过去，再由 arrival 段按到达区域判定并引爆。
    --
    --   优先级（保守，不抢既有行为）：**虫洞标记 > 引擎自选的泰坦/弱点 > ping 地面点**。
    --   即只有这颗 G-60 既没被虫洞标记认领、引擎也没选中泰坦类目标时才接管。
    --
    --   ⚠ 两个前提（都必须满足，否则这条能力不会生效）：
    --     ① **有敌人**：G-60 必须先被引擎驱动到 state 4。附近没敌人时它停在
    --        state 2/3（弹道模式，已实测定论）⇒ 标记任何东西都不会飞。
    --     ② **玩家 ping 的是空地**：ping 到实体时走原有的实体接管路径（更精确）。
    --
    --   `point_target_ttl_frames`：同一个 ping 标记只在这么多帧内作数
    --     （≈20 秒 @60fps）。为什么要它：ping 标记在引擎里的存活时长我们无法从
    --     `+0x14` 判断（实测那不是时间戳），而"顺手 ping 一下地面"不该长期劫持 G-60。
    --     标记被引擎淘汰时位置读取会变 nil ⇒ 自然释放；TTL 是第二道闸。
    --     置 0 等同于"只在 ping 的那一帧有效"（不建议）；置 false 关闭整个能力。
    --
    --   `point_arrival_region`：到达判定区域（圆柱，语义同 titan_arrival_region）。
    --     G-60 飞向地面点时通常会悬在它**上方** ⇒ 必须给 `above` 留量，
    --     否则 dz>0 恒不成立、永远判不到达（虫洞那次的同款坑）。
    point_target_enabled=true,point_target_ttl_frames=1200,
    -- ★★ 观测节流周期（2026-10-03，用户要求）★★
    --   `Layout.capture`（遍历 behavior 数组找 G-60）原本是**每帧**跑一次；
    --   2026-10-02 起改为"有事可做才每帧、纯空转隔 3 帧"；本次再把两档放宽：
    --     · `scan_every_busy` —— 有事可做（持有/可接管/早期探测）时每 N 帧观测一次（默认 **2**）
    --     · `scan_every_idle` —— 纯空转（没有可接管的 G-60）时每 N 帧观测一次（默认 **6**）
    --   ⚠ **引擎选中要否决的目标那一路仍每帧重申**，不受这两个值影响
    --     （见 runtime 的 `veto_must`；"否决必须每帧重申"是本工程的既有安全属性）。
    --   ⚠ 代价（知情）：空转时投掷的 G-60 最多晚 5 帧（≈83 ms）被发现；
    --     有事可做时最多晚 1 帧（≈17 ms）。
    --   ⚠ 0 安全（闸门 `if P.idle_skip>0` 会短路），**负数危险**（会让
    --     `frame%N` 恒为 0 ⇒ mod 永远不跑）；runtime 对非数/0/负数一律回默认值。
    scan_every_busy=2,scan_every_idle=6,
    -- ★★ 单位标记的记忆判据（2026-10-01，用户实机反馈）★★
    --   用户原话：「标记过的单位，即使取消标记，G60 仍会追踪该单位」。
    --
    --   根因：ping_memory 的设计原本是"UI 过期不代表意图过期"（只要实体还有效就
    --   一直留在记忆里）—— 这对**虫洞**是对的（"ping 一次虫洞、过一会儿才扔"是
    --   常规操作），但对**通用单位**就成了"取消不掉"：标记从画面上消失后，
    --   之后每一颗 G-60 还是会照记忆里的旧标记去追那个单位。
    --
    --   本开关 = true（默认）：**通用单位标记只在该 ping 标记仍然可见时算数**
    --     （`keep_intent` 的 live 判据，见 g60.ping_memory / native_ping）。
    --     · 结构 / 泰坦 / 蟑龙 / 变体 **不受影响**：照旧长期记忆
    --     · **已在飞向它**的那颗也不受影响：它持有 old.lock，走 sticky 复核
    --       （按实体 id 重读），不依赖这条记忆 —— 2026-09-28「半路停手」的修复
    --       不会被这条改回退
    --   置 false：回到旧行为（记忆里的旧单位标记继续被新 G-60 接管）。
    --   ⚠ 若你觉得"ping 完过一会儿再扔"对单位太短（标记 UI 约 8 秒），
    --     就是这一格要调 —— 告诉我想要的时长，我改成可配的帧数上限。
    unit_mark_live_only=true,
    -- ★★ 2026-10-02：**结构标记也只认活标记**（用户：「标记虫洞再取消标记丢出手雷，
    --   手雷还是会向虫洞飞过去爆炸」）。
    --   · true（默认）⇒ 只有本帧 ping 环里还看得到的结构标记才被接管 ⇒ **取消即失效**
    --   · false ⇒ 回到旧的"长期记忆"（UI 过期不代表意图过期）
    --   ⚠ 权衡：ping 之后超过标记存活时长（UI 约 8 秒）才扔 ⇒ 结构标记已过期 ⇒ 不接管。
    --   ⚠ 已在飞向它的那颗不受影响（持有 old.lock，走 sticky 复核）⇒ 不会半路停手。
    structure_mark_live_only=true,
    -- ★★ 2026-10-02：**标记队列按优先级排序**（用户：「标记敌人单位时，泰坦的优先级不是最高的」）。
    --   背景：队列默认按**新旧**排（队首 = 最晚 ping 的那个）⇒ 先标泰坦、后标一只小怪时，
    --   小怪会盖住泰坦。名册（`compat/priority_catalog.lua`）里的 rank 本来就把泰坦/蟑龙
    --   定为 10（最低数 = 最高优先级），但它只被**自动索敌**路径用过，而那条路径已裁掉。
    --   · true（默认）⇒ 队内次序 = ① 虫洞/构筑(0) → ② 泰坦含变体(1000) →
    --                    ③ 名册敌人(1000+rank) → ④ 其它单位(1500)；相等则仍按"最新 ping 优先"
    --   · false ⇒ 回到旧行为（纯"最新 ping 优先"）
    --   ⚠ 只影响**玩家标记**的那条队列；空白标记（ping 空地）与引擎自选都不受影响。
    marked_unit_rank_first=true,
    --   ★ 2026-10-01 首次放宽：地面点不需要泰坦那种"贴腹"精度，取策略断言的上限附近
    --     （arrival_policy: radius<=3 / depth<=2 / above<=2）。
    --     首测若出现 `point_stalled`（4 秒内没满足到达）就继续在这一格调；日志里
    --     `point_guide;dist=` 会每 60 帧报一次当前距离，直接看它最近靠到多少。
    point_arrival_region={radius=3.0,depth=2.0,above=2.0},
    -- ★ 到达区域（**泰坦/变体专用**）—— 判定形状 = **圆柱**（2026-09-30 试过球形，
    --   实机效果差 ⇒ 已回滚；公式见 arrival_policy: `dx²+dy²<=r² 且 -depth<=dz<=above`）。
    --   历史：这段原本按**虫洞**标定过（2026-09-28：上游 {radius=1.75,depth=0.8}
    --   的 `dz<=0` 要求"必须在目标点下方"，而 G-60 绕洞口飞时恒在**上方** ⇒
    --   实机 target=529 的 5 个采样点 **0/5**；放宽到 above=1.2/radius=2.0 ⇒ **4/5**，
    --   当时成功引爆距离 1.33~2.05m）。
    --   但**现状已不同**：虫洞改走 `structure_route` 的 `kind='entrance'` 盒状区域，
    --   而 `allow_state3=false` ⇒ early_drive 关闭 ⇒ 本 region 只剩
    --   **泰坦专用路径**（native_titan_aim，stage 前缀 `'titan/'`）在用。
    --   ⇒ 2026-09-30 取值轨迹：2.0 →（球形试验）1.75 → 回 2.0 → **2.25（当前）**。
    --     ★ 2.0 → 2.25 的理由：用户报"G-60 到达引爆点耗时久"，而实测瓶颈是**绕行几何**
    --       （12m 外圈 / 20°/步，单次 3.0~4.7s；捷径②放宽到数学上限后仍 0 命中）。
    --       本值**同时**是 titan_route 的 `terminal_radius` ⇒ 调大后：
    --         · `under` 段里 `radius<=terminal_radius` 更早成立 ⇒ **更早切 attack 直冲**（本轮目的）
    --         · 绕过默认绕行的门槛更宽
    --       代价：爆点离腹部略远（2.0→2.25 只多 0.25m，属小幅），需实机确认"炸得死"。
    --       注：捷径②要求 `radius>terminal_radius` ⇒ 调大本值会**略收窄**那条走廊，
    --       但该捷径实测 0 命中，无实际影响。
    --   配置断言范围：radius ∈ (0, 3]。
    --
    --   ★★ 2026-10-02 第三次调整（**回退收紧**）：**1.0 → 1.5（当前）** ★★
    --   第二次把它收到 1.0（"强制靠到中心才炸"）之后，实机出现**一颗根本不引爆**：
    --     `entity=1320 / target=1314`（泰坦在**走动**，位移 ~50 m）在 `under` 阶段
    --     反复振荡，`goal_dist` 始终 **1.2~3.0 m** ⇒ **从未满足"水平 ≤ 1.0"** ⇒ 不引爆 ⇒ 无声消失。
    --   ⇒ 判定球太小会把"移动中的泰坦"整颗漏掉（浪费一颗手雷、泰坦还活着）——
    --     这比"爆点略偏侧"严重得多（1.75 时用户实测评价是"**体验还行**"）。
    --   ⇒ 取 **1.5**：落在"1.0（太紧、会漏炸）"与"1.75（你说体验还行）"之间，
    --     既让判定球有足够余量接住移动目标，又不比 1.75 更容易偏侧。
    --   ⚠ 本值**同时**是 `titan_route` 的 `terminal_radius` ⇒ 两侧方向一致：
    --     · `attack` 更早触发（`radius<=1.5`）⇒ 提前进入末端接近
    --     · 捷径② 的走廊 `radius>terminal_radius` 略窄（1.5~12）—— 影响可忽略
    --   ⚠ 上游 `arrival_policy` 的默认半径是 0.8；本值仍比上游宽。
    --   微调方向：若又出现"偶尔炸不死/偏侧" ⇒ 回 **1.25**；若仍"飞过去不炸" ⇒ 上 **1.75**。
    --
    --   ★ 机制（用户）：G60 靠**多部位伤害累加** ⇒ 爆点要落在"正下方 + 离腹部约 standoff"的
    --     **紧凑球**内；**偏侧**（radius 大）或**贴脸**（`belly_above` 大）都会减少受伤部位。
    --     两个维度一起收：`radius=1.5` + `titan_belly_above=0`。
    --     ⚠ 但"紧凑"有下限：球太小 ⇒ 接不住移动目标 ⇒ 整颗漏炸（见上）。
    -- ★ 2026-10-05：回到**上游原值** `{radius=1.75,depth=0.8}`（我们曾按实机收到 1.5/1.2，并加了 above）。
    --   泰坦 baseline 的区域现在由 `BlastRoute`/`Adaptive` 经 `options.region` 下发，
    --   本项只在它们**都没给区域**时兜底（`native_arrival` 的 env.titan_arrival_region 回落）。
    titan_arrival_region={radius=1.75,depth=0.8},
    -- ⚠ 2026-10-05：原有「腹部提前引爆余量」`titan_belly_above` **已按上游移除**。
    --   上游没有这个量；它只在"竖直爆点"（`blast_z = 腹点 - standoff`）几何下才有意义，
    --   而现在泰坦爆点由 `Adaptive` 决定（腹法线×2.5 + `surface` 区域）。
    -- ★★ 泰坦模板：animated_belly（2026-10-04 自上游 1.1.0 整合）★★
    --   true ⇒ `titan_context.capture` 会读 `belly` 骨骼的**真实姿态**当爆点：
    --     ① 泰坦蜷曲/扑击时腹部大幅位移 ⇒ 静态几何会算错（这正是我们当初要反复试错
    --        标定 `titan_standoff` 的原因）；② 偏移 > `max_offset²`（3.0²）**或**法线
    --        不再朝下 ⇒ 自动**退回静态几何**（不会把爆炸授权到远处）。
    --   false ⇒ 逐字回到整合前行为（`belly_pose` 不读，`point` 仍为 `aim_pose + offset`）。
    --   ⚠ 首次上机请对比 `titan_probe;` 的 `dz` 与击杀手感；无效就置 false 回退。
    titan_animated_belly=true,
    -- ★★★ 早期接管（2026-10-04 用户拍板**打开**）★★★
    --   为什么开：玩家反馈「标记的目标会脱锁」。查下来根因是**接管窗口太短** ——
    --     手雷以原版弹道飞着，要等**引擎先选中**它（state 4）我们才能改导航，
    --     而这几帧里它往往已经撞上东西自爆（本局 10 次 `arrival_skipped`）。
    --   true ⇒ 手雷在 state 2/3（引擎还没给目标）时**也能被驱动** ⇒ 不必等引擎。
    --   ⚠ **历史警告（务必知情）**：两轮早期实验的既得结论是
    --     「state 2/3 的导航**不读任何目标数据**」（写入回读一致，但 G-60 仍停在 state 3）、
    --     「早期纯 ballistic 飘向别处」。所以本开关**未必有效** —— 实测说了算。
    --   ⚠ 已有 `state3_danger` 熔断：连续 `STATE3_DANGER_LIMIT` 次早期接管失败会
    --     **自动退回 state-4-only**，不牵连其余功能（见 experimental_runtime 的
    --     `state3_takeover_disabled` 日志）。若上机后看到它 ⇒ 说明这条路确实不行。
    --   ⚠ 回退：置 false ⇒ 逐字回到打开前的行为（状态行里 `allow_state3=false`）。
    allow_state3=true,
    -- ★★ 强制提升 state=4（2026-10-09，用户拍板"走写内存这条路"的实验）★★
    --   为什么需要：引擎只在"候选分数 > 0"时置 state 4，而虫洞不在候选列表里
    --   ⇒ 无敌人时永远进不去 state 4 ⇒ 引导不跑 ⇒ 我们写的点被 0.25 s 一次的
    --   orbit（state-3 转换）冲掉、手雷原地飘走。
    --   行为：**仅在**「我们持有这颗雷 + 已标记虫洞 + 引擎把它留在 state 2/3」时，
    --   按引擎自己的提升块**逐字段**把状态记录写成 state=4：
    --     [+8]=4（state）、[+4]=0xffffffff、[+0]=4（behavior）
    --   —— 三处偏移与值都来自 game.dll 的反汇编（0xbbc91 / 0xbbc9c / 0xbbcb0），
    --      不是猜的；写前复核 + 写后回读，失败只记一行、不改其它行为。
    --   ⚠ 这是**本工程唯一的写内存路径**（见本文件 write() 的边界说明）。
    --   ⚠ 置 false ⇒ 完全回到只读行为（**一键回退**）。
    force_lock_enabled=true,
    -- ★ 2026-10-09 候选组探针**已移除**（原 `cand_probe_enabled`）：
    --   它是为"写入候选分数"那条路服务的。实机结论是**那条路不需要了**——
    --   强制提升 state=4 之后引擎自己就接管了引导（5/5 炸毁虫洞），
    --   而探针本身读 manager 拿到 `0xffffffff`（无候选时的哨兵值），没产出有效数据。
    --   保留的知识（写进 README 与工作日志，别丢）：
    --     · **候选分数确实是内存字段** `候选记录+0x44`（float，引擎在 0xbbac9 写 max(分,0)）；
    --     · 接受判据 = 分数>0 且 `+0x48`≠0 且 `+0x4c`≠0（见 native_candidates.lua:29）；
    --     · 但提升判据读的是 seek 函数**栈帧副本**，且**虫洞从来不在候选列表里**
    --       ⇒ 无敌人时无候选可评分 ⇒ 只能靠 force_lock 直接提升状态。
    experimental=true,native_lifetime_verified=false,state='starting'}
rawset(_G,'G60BugholeLock',state)
local log,host
local function close()
    local handle=log;log=nil
    if handle then pcall(function() handle:close() end) end
end
local ok,why=pcall(function()
    local ffi=require('ffi')
    assert(ffi.os=='Windows' and ffi.abi('64bit'),'Windows x64 required')
    @@MODULES@@
    local loader=assert(rawget(_G,'CowboyBingusModLoader'),'loader unavailable')
    assert(loader.api==1,'loader API unavailable')
    -- Diagnostics are optional; logging failures must not disable gameplay.
    if type(loader.open_log)=='function' then
        local opened,handle=pcall(loader.open_log,'G60BugholeLock.log')
        if opened then log=handle end
    end
    local written,lines=0,0
    local last_issues,issue_keys={},0
    local function emit(line)
        if not log then return end
        -- Bounded diagnostic output must not stop filtering during a long mission.
        line=tostring(line):gsub('[\r\n]',' '):sub(1,900)
        lines=lines+1
        local issue=line:match('^skipped;') or line:match('^frame_error;') or line:match('^titan_skipped;')
            or line:match('^priority_skipped;') or line:match('^ping_unavailable;')
            or line:match('^arrival_skipped;')
            or line:match('^structure_unavailable;') or line:match('^structure_ping_unavailable;')
        local key=issue and (issue..(line:match('entity=(%d+)') or 'global'))
        local fresh_issue=key and line~=last_issues[key]
        if key then
            if not last_issues[key] then issue_keys=issue_keys+1 end
            if issue_keys>64 then last_issues={};issue_keys=1 end
            last_issues[key]=line
        end
        -- ★ 日志节流白名单（2026-09-29 修）★
        --   超过 60 行后只写"关键行"，其余静默丢弃。原来的白名单**漏了两类**：
        --     arrival_already_exploded —— 我新加的收尾事件
        --     guide_give_up            —— 引导熔断事件
        --   后果：实机 `arrival_skipped;...explosion already requested` 出现了，
        --   但对应的 `arrival_already_exploded` 一条都没有 ⇒ 我据此误判
        --   "收尾逻辑没生效"，又白查一轮。
        --   **诊断被节流掉 = 诊断不存在。** 凡是我会用来判断成败的事件，
        --   都必须进白名单。
        if lines>60 and lines%120~=0 and not fresh_issue and not line:find('disabled',1,true)
            and not line:match('^titan_started;') and not line:match('^titan_stage;')
            -- ★ 泰坦接近诊断（2026-10-02，每 30 次调用一条）：是"腹部盘旋多久 / 卡在
            --   哪个高度 / 窗口差多少"的**唯一数据源**。被节流掉 = 诊断不存在
            --   （同日 arrival_already_exploded 已经栽过一次）。
            and not line:match('^titan_probe;')
            and not line:match('^priority_locked;')
            and not line:match('^structure_mark;') and not line:match('^structure_stalled;')
            and not line:match('^arrival_detonated;') and not line:match('^arrival_retired;')
            and not line:match('^titan_released;')
            and not line:match('^arrival_already_exploded;')
            and not line:match('^guide_give_up;')
            -- ★ 泰坦净空拒绝的几何画像：这是用来决定"能不能优化"的唯一数据源，
            --   被节流掉就等于没测（同日 arrival_already_exploded 已经栽过一次）。
            and not line:match('^titan_clearance;')
            -- ★ 2026-10-05：`titan_refine_failed;` = `Adaptive`/`BlastRoute` 的断言在实机抛错时的
            --   **唯一判据**（表现是「泰坦一整局都不接管」）⇒ 必须常驻。
            and not line:match('^titan_refine_failed;')
            -- ★ 2026-10-02：引爆瞬间的**腹部距离**（`belly_dz = own_z - 腹点z`）。
            --   用户报"偶尔在距离腹部极近处引爆"—— `dz`/`horiz` 都是相对**目标点**的，
            --   而目标点会被地面净空抬高 ⇒ 两者不等价。这一行才能直接回答"离腹部多远"。
            --   被节流掉 = 下次又是猜。
            and not line:match('^titan_blast;')
            -- ★ 否决与其只读诊断必须常驻：诊断被节流掉 = 诊断不存在
            and not line:match('^enemy_veto;')
            and not line:match('^enemy_selection;')
            -- ★ 通用接管与其诊断必须常驻（诊断被节流掉 = 诊断不存在）
            and not line:match('^generic_takeover;')
            and not line:match('^generic_rejected;')
            -- ★ 2026-10-01：玩家点名标记运输船/增援飞船时，索敌硬门槛被放行的证据行
            --   （没有它就无法确认"是这条例外让它飞过去的"）
            and not line:match('^generic_native_invalid_allowed;')
            -- ★ 2026-10-01：早期导航探测（每颗 G-60 一条，是"无敌人能否驱动"的唯一判据）
            and not line:match('^early_nav_probe;')
            and not line:match('^early_nav_orbit;')
            -- ★ 2026-10-07：转阶段探针（每颗 G-60 每次选择变化一条）——
            --   它是"引擎何时转索敌、锁了谁"的唯一判据，被节流掉 = 探针不存在
            and not line:match('^sel_probe;')
            -- ★ 2026-10-07：代码探针（一次性，每次启动 6 条）——
            --   它是"运行时机器码是否取到"的唯一判据
            and not line:match('^codeprobe;')
            -- ★ 2026-10-08：目标字段探针（每个被标记目标一条）——
            --   它是"引擎凭什么接受/拒绝这个目标"的唯一判据
            and not line:match('^target_fields;')
            -- ★ 2026-10-09：调用者扫描（谁在起索敌）+ 状态记录里的代码指针
            and not line:match('^callerscan;')
            and not line:match('^callerscan_done;')
            and not line:match('^constprobe;')
            -- ★ 2026-10-09：state=4 写入点扫描（找可调用的提升函数）
            and not line:match('^statescan;')
            and not line:match('^statescan_done;')
            and not line:match('^recptr;')
            -- ★ 2026-10-01：ping 槽全字段 dump（"空白标记"探查，每槽一次）
            and not line:match('^ping_slot;')
            -- ★ 2026-10-01：空白标记位置（每项一次；"指哪打哪"的前置验证）
            and not line:match('^point_marker;')
            -- ★ 2026-10-01：点目标接管/释放（每颗每次一条 —— 是"有没有生效"的唯一判据）
            and not line:match('^point_taken;')
            and not line:match('^point_released;')
            -- ★ 2026-10-01：点目标的引导/停滞诊断（点目标的 guide/search 原本完全静默，
            --   实机"飞过去没炸"时日志里只有 point_taken、什么都看不出）
            and not line:match('^point_guide;')
            and not line:match('^point_stalled;')
            -- ★ 2026-10-03：**体内爆点**的到达诊断。原来只有 `point_*`（判据 `old.point`）⇒
            --   体内爆点走 `P.site` 时**完全静默**，"低抛那颗飞到哪了"无据可查。
            and not line:match('^blast_guide;')
            and not line:match('^blast_stalled;')
            -- ★ 2026-10-01：点目标"已就绪"（与结构标记并存时打一行，解释优先级）
            and not line:match('^point_armed;')
            -- ★ 2026-10-05：**玩家的 ping 落点压过"引擎自选泰坦"**的事件行。
            --   它是这条修复是否生效的唯一判据（按手雷去重）。
            and not line:match('^point_beats_titan;')
            -- ★ 2026-10-05：priority 认出"这个点是我们自己写的"⇒ 跳过冗余 setter
            --   （移植上游的 `continued`）。它是"新机制真的生效了吗"的**唯一**判据；
            --   按 (G-60, 目标) 去重 ⇒ 不会刷屏（条件每帧都成立）。
            and not line:match('^priority_continued;')
            -- ★ 2026-10-01：优先级让位事件（结构 > 标记单位 > 空白标记）。
            --   这是"我标记了虫洞，G-60 却继续追那个单位"是否已修好的**唯一判据** ——
            --   诊断被节流掉 = 诊断不存在（同日 arrival_already_exploded 已栽过一次）。
            --   本次让位事件已按 (G-60, 结构) 去重，不会刷屏。
            and not line:match('^unit_lock_yielded;')
            -- ★ 2026-10-03：已爆手雷短路（写内存**之前**的一次只读探测）。
            --   它是"12 次标记全是锁上即已爆"这类局面的**唯一判据** ——
            --   用于确认短路真的生效（不再出现误导性的 priority_locked）。
            --   诊断被节流掉 = 诊断不存在（同日 arrival_already_exploded 已栽过一次）。
            and not line:match('^priority_precheck_exploded;')
            -- ★ 2026-10-09：强制提升 state=4 的结果（写前/写后值）——
            --   它是"写内存这条路到底成不成"的**唯一判据**，被节流掉 = 实验没法判读
            and not line:match('^force_lock;')
            -- ★ 2026-10-03：体内爆点（巨型构筑者）—— 每目标一条，
            --   是"lift 到底生效了没有 / 爆点落在哪"的**唯一判据**。
            --   诊断被节流掉 = 诊断不存在（同日 arrival_already_exploded 已栽过一次）。
            and not line:match('^blast_point;')
            -- ★ 2026-10-03：体内爆点的**证据行**（"这颗实际在哪炸的"，每颗一条）——
            --   它是"打没打准 / 抬高生效没有"的唯一量化依据。
            and not line:match('^blast_hit;')
            -- ★ 2026-10-07：generic 认领 profile 的 pose capture 失败回落 motion 位置。
            --   它是"爆点退化为实体位置"的唯一判据 —— 被节流掉 = 诊断不存在。
            and not line:match('^generic_pose_fallback;')
            -- ★ perf 窗口行必须常驻：它是"优化有没有效"的唯一判据，
            --   被节流掉就等于没测（同日 arrival_already_exploded 已栽过一次）。
            and not line:match('^perf;') then return end
        if written+#line+1>262144 then close();return end
        local good=pcall(function() assert(log:write(line..'\n'));assert(log:flush()) end)
        if not good then close() else written=written+#line+1 end
    end
    ffi.cdef[[void *GetModuleHandleA(const char *);void *GetCurrentProcess(void);
        uint32_t GetCurrentThreadId(void);
        int ReadProcessMemory(void *,const void *,void *,size_t,size_t *);
        int WriteProcessMemory(void *,void *,const void *,size_t,size_t *);]]
    local k=ffi.load('kernel32');local process=k.GetCurrentProcess()
    local function read(a,n)
        assert(type(a)=='number' and a>=65536 and a+n<2^47 and n>0 and n<=32768,'read bound')
        local b,count=ffi.new('uint8_t[?]',n),ffi.new('size_t[1]')
        assert(k.ReadProcessMemory(process,ffi.cast('const void *',a),b,n,count)~=0
            and tonumber(count[0])==n,'native memory unreadable')
        return ffi.string(b,n)
    end
    -- ★★ 受控写内存（2026-10-09，用户明确拍板"走写内存这条路"）★★
    --
    --   唯一用途：把 G-60 的状态记录提升到 state 4。
    --   为什么非要开这个通道：引擎**只在"候选分数 > 0"时**才置 state 4
    --   （seek 函数 0xbafb0：阈值 `xorps xmm9,xmm9`=0.0、取最大分、
    --     `0xbbc2e test ebx,ebx; js 0xbbc49` 无候选就**直接返回、不置 4**），
    --   而**建筑/虫洞从来不在引擎的自动候选列表里**
    --   （上游原话 `Never discover structures from the automatic candidate list`）
    --   ⇒ 无敌人时永远进不去 state 4 ⇒ 引导不跑 ⇒ 我们写的点被每 0.25 s 一次的
    --   orbit（state-3 转换，重置飞行计时器）冲掉 ⇒ 手雷原地飘走、超时自爆。
    --   本工程此前**只有只读通道**（ReadProcessMemory + 6 个引擎函数），
    --   而 `clear` 的反汇编证明它只拷记录 + 置 +0x70 + 写 +0x68/0x6c、**不碰 state**
    --   ⇒ 想绕过那道门，只能开这一个写通道。
    --
    --   ⚠ 三条硬边界（调用方必须遵守，守门钉着）：
    --     1) 单次最多 64 字节；
    --     2) 调用方**写前复核 + 写后回读**（见 native_priority 的 promote_state4）；
    --     3) 只允许用于状态记录那 3 个 dword，不得挪作他用。
    --   ⚠ **不需要改页保护**（那个 API 仍在 `scripts/build.py` 的禁用词表里，
    --     本文件**连注释都不许写它的名字**——工程为此栽过一次）：该记录是堆内存，
    --     引擎自己一直在写它（`clear` 就写 obj+0x10..0x5f、+0x70、+0x68）
    --     ⇒ 页权限本来就是可写。
    --   ⚠ `scripts/build.py` 的禁用词表对本符号开了**计数式例外**：必须恰好 1 处调用；
    --     其余高危 API 见该表的词条，**仍然一律禁止**（本文件不得提及其字面量）。
    local function write(a,s)
        assert(type(a)=='number' and a>=65536 and a+#s<2^47 and #s>0 and #s<=64,'write bound')
        local b,count=ffi.new('uint8_t[?]',#s),ffi.new('size_t[1]')
        for i=1,#s do b[i-1]=s:byte(i) end
        return k.WriteProcessMemory(process,ffi.cast('void *',a),b,#s,count)~=0
            and tonumber(count[0])==#s
    end
    local module=k.GetModuleHandleA('game.dll');assert(module~=nil,'game module unavailable')
    local base=tonumber(ffi.cast('uintptr_t',module))
    local exe=tonumber(ffi.cast('uintptr_t',assert(k.GetModuleHandleA(nil))))
    for _,g in ipairs(@@GAME_GUARDS@@) do
        local expected=g[2]:gsub('..',function(b) return string.char(tonumber(b,16)) end)
        assert(read(base+g[1],#expected)==expected,'game layout mismatch')
    end
    local main_code=('@@ENGINE_CODE@@'):gsub('..',function(b) return string.char(tonumber(b,16)) end)
    assert(read(exe+0xa3e50,#main_code)==main_code,'engine layout mismatch')
    -- ★★ 代码探针（2026-10-07，用户拍板"路线 A"）★★
    --
    --   把运行时机器码按 hex 打进日志，离线用反汇编器读逻辑。
    --   目标 RVA（全部来自已逆向的锚点，不是猜的）：
    --     clear            0x4af4e0  上游记了完整入口签名 ⇒ 可用来复核取字节没错位
    --     orbit            0x4dec30  同上
    --     target_valid     0x8858a0  ★ 引擎"能不能当锁定目标"的判据（本工程记录在案）
    --     category_mask    0x8859c0  候选类别掩码测试（+0x4c）
    --     empty_queue_gate 0x843090  无候选时走哪条分支（上游注释记录过）
    --     candidates       0x889940  候选表 sparse-special 序数
    --   ⚠ 放在 88 条签名校验**之后**：能执行到这里就证明 base 与 RVA 映射正确、
    --     读到的确实是真代码（签名逐一比对通过），下面的字节可信。
    --   ⚠ 长度取 512/256：`read` 的上限是 32768，足够；再长只是浪费日志配额
    --     （日志总量上限 256 KB，这 6 条约 5 KB）。
    --   ⚠ 十六进制转换用 `gsub('.',…)` —— Lua 的 `.` 匹配**含 \0 与 \n 的所有字节**，
    --     不会漏字节导致错位（这点必须成立，否则反汇编全错）。
    if state.code_probe_enabled then
        local function dump_code(tag,rva,n)
            local function hex(s)
                return (s:gsub('.',function(c) return string.format('%02x',string.byte(c)) end))
            end
            -- ★ 必须分块：`emit` 单行上限 **900 字符**（本文件 `:sub(1,900)`）——
            --   2026-10-08 首轮实测：512 字节 → 1024 hex **被静默截断到 419 字节**
            --   （幸好函数体短、`ret` 后是 int3，才没影响结论）。256 字节/行最长
            --   约 600 字符，安全。
            local off=0
            while off<n do
                local chunk=math.min(256,n-off)
                local ok,bytes=pcall(read,base+rva+off,chunk)
                if ok then
                    emit('codeprobe;tag='..tag..';rva='..string.format('%x',rva)
                        ..';off='..tostring(off)..';base='..string.format('%x',base)
                        ..';len='..tostring(chunk)..';hex='..hex(bytes))
                else
                    emit('codeprobe;tag='..tag..';rva='..string.format('%x',rva)
                        ..';off='..tostring(off)..';error='..tostring(bytes))
                end
                off=off+chunk
            end
        end
        -- ★★ 浮点常量探针（2026-10-09）：读 .rdata 里被 RIP 相对寻址引用的常量 ★★
        --   用途：确认 seek 函数里那几个魔数的真实数值 ——
        --     · 0xbb009/0xbb011/0xbb019 装的三个 xmm = orbit 的三个实参
        --       （上游记为 10.0 / 2.5 / 1.2000000476837158）
        --     · 0xbb070/0xbb07b/0xbb089 那三个乘出来的值 = "下次允许时间"的间隔
        --       ⇒ 直接验证 sel_probe 观察到的 ~22 帧周期（0.367 s = 367000 µs）
        --   地址 = 指令地址 + 指令长度 + rip 偏移（离线算好，不是猜的）。
        local function dump_f32(tag,rva)
            local ok,b=pcall(read,base+rva,4)
            if ok and #b==4 then
                local q1,q2,q3,q4=b:byte(1,4)
                local u=q1+q2*256+q3*65536+q4*16777216
                local box=ffi.new('uint32_t[1]',u)
                emit('constprobe;tag='..tag..';rva='..string.format('%x',rva)
                    ..';f32='..tostring(tonumber(ffi.cast('float *',box)[0])))
            else
                emit('constprobe;tag='..tag..';rva='..string.format('%x',rva)
                    ..';error='..tostring(b))
            end
        end
        dump_f32('orbit_arg3',0x23c6e28)
        dump_f32('orbit_arg2',0x23c71e0)
        dump_f32('orbit_arg1',0x23c7554)
        dump_f32('cooldown_a',0x23c6d70)
        dump_f32('cooldown_b',0x23c68c0)
        dump_f32('cooldown_mul',0x23c7ec0)
        -- 通道金丝雀：这两个自带上游记录的入口签名 ⇒ 每轮都复核"有没有读错位"
        dump_code('clear',0x4af4e0,256)
        dump_code('orbit',0x4dec30,256)
        -- target_valid 本体 0x8858a0–0x8859b5（277 B）⇒ 384 覆盖完整（2 行）
        dump_code('target_valid',0x8858a0,384)
        -- ★ 第二轮新增：target_valid 内部**真正做判断**的两个子函数 + 两个基础设施
        --   pred_f0c = 0x13e1b50（吃 f0c，返回值 >=1 即拒）
        --   flags_f08 = 0x4a9710（吃 f08，返回带 bit25 的标志字）
        --   resolve_id = 0xfd9d40（entity==NULL 时按 id 解析）
        --   set_lookup = 0x927050（全局集合查询，命中且为真即硬拒）
        dump_code('pred_f0c',0x13e1b50,256)
        dump_code('flags_f08',0x4a9710,256)
        dump_code('resolve_id',0xfd9d40,256)
        dump_code('set_lookup',0x927050,256)
        -- ★★ state-3 转换（2026-10-09）：这就是"让 G-60 开始索敌"的那段代码 ★★
        --   上游原文（_refs/g60-smart-targeting-1.1.0-analysis.md:36）：
        --     -- Exact argument types/order and float constants of game 0xbb009..0xbb021.
        --     -- Never call the state-3 transition, which resets the flight timer.
        --     calls.orbit(pair,10.0,2.5,1.2000000476837158)
        --   ⇒ `0xbb009..0xbb021` 就是**把 G-60 打回索敌态（orbit）并重置飞行计时器**
        --     的那段代码。而调用者扫描实测：整个代码节里 `orbit` **只有这一个**
        --     调用点（from=bb021），与上游记录**同址** —— 两条独立证据互相印证。
        --   函数起点在该段之前 ⇒ 往前多读 2 KB，便于离线按 int3 填充找函数边界。
        dump_code('seek_fn',0xba800,2304)
        -- ★★ 2026-10-09 续：seek 函数**余下全部**（0xbb100 → 0xbbd21 的 ret）★★
        --   已解出的开头（0xbafb0 起）：
        --     · `[obj+0x180] + 0x1c9c380(=30,000,000) vs 全局时钟` ⇒ 过期则 state=5
        --       （⇒ 时钟单位是**微秒**，30,000,000 µs = G-60 的 30 秒寿命）
        --     · 未过期 ⇒ 0xbb009 装 3 个浮点常量 → **0xbb021 call orbit**（state-3 转换）
        --     · 之后 `[obj+0x90]` 是"下次允许时间"：未到点直接 return；
        --       到点则重排 `[0x90] = now + int(常量×常量)`（这就是那 ~22 帧的周期）
        --     · 再往下 `call 0x889830` → `imul 0x13f8` → `[global+0x50]+key*0x13f8`
        --       → 读三个候选组计数 `+0xd20/+0x818/+0x310` ⇒ **开始枚举候选**
        --   ⇒ 余下这段就是"选目标 / 置 state"的逻辑，必须读完才能判断
        --     无敌人时它为什么不选虫洞。
        dump_code('seek_fn2',0xbb100,15360)
        -- ★ 第二个 orbit 调用点（全量扫描才捞到，上一轮被 300 上限截断漏掉）
        dump_code('orbit2',0x425300,1024)
        -- ★★ 调用者扫描（2026-10-09）：找"引擎自己开始索敌"的代码位置 ★★
        --
        --   原理（不是猜的）：**我们自己的代码就是靠 clear(0x4af4e0)+orbit(0x4dec30)
        --   起索敌的**（见 native_arrival 的 search 分支：calls.clear + calls.orbit）。
        --   ⇒ 引擎自己的"起索敌"必然也走这两个原语（或走索敌系统的
        --     target_valid / category_mask / candidates）。于是扫 `.text` 里的
        --     `E8 rel32`，把"调用这些已知锚点"的位置全打出来 —— 那些调用点
        --     就是引擎的索敌/选目标逻辑所在。
        --
        --   范围只取**第一个节**：本工程实测该节 char=0x60000020（code），
        --   其余大节 char=0x40000040（data）⇒ 限定 [0x1000,0x2110a93) 天然只捞代码。
        --   ⚠ 纯只读、启动时跑一次、只打命中地址（不打代码本体，几十条）。
        --   ⚠ 逐块读（read 上限 32768）+ 每块多读 4 字节，防 `call` 指令跨块被漏掉。
        local anchors={[0x4af4e0]='clear',[0x4dec30]='orbit',
            [0x8858a0]='target_valid',[0x8859c0]='category_mask',
            [0x889940]='candidates',[0x8cdf80]='explode',
            [0xfd9d40]='resolve_id',[0x927050]='set_lookup',
            -- ★ 2026-10-09：seek 函数本身（0xbafb0）也当锚点 ⇒ 找出**谁触发它**
            --   （是调度队列派发？还是逐帧调用？这决定我们能不能绕开它）
            [0xbafb0]='seek_fn'}
        local order={'clear','orbit','target_valid','category_mask','candidates',
            'explode','resolve_id','set_lookup','seek_fn'}
        local clock=os and os.clock
        local t0=clock and clock() or 0
        local counts,first,last,total={},{},{},0
        local off=0x1000
        while off<0x2110a93 do
            local n=math.min(32764,0x2110a93-off)
            local ok,b=pcall(read,base+off,n+4)
            if ok then
                local i=1
                while true do
                    local p=b:find('\232',i,true)
                    if not p then break end
                    if p+4<=#b then
                        local q1,q2,q3,q4=b:byte(p+1,p+4)
                        local rel=q1+q2*256+q3*65536+q4*16777216
                        if rel>=2147483648 then rel=rel-4294967296 end
                        local at=off+(p-1)
                        local name=anchors[at+5+rel]
                        if name then
                            total=total+1
                            counts[name]=(counts[name] or 0)+1
                            first[name]=first[name] or at
                            last[name]=at
                            -- 只逐条打 orbit：它是"起索敌"的唯一原语调用点，
                            -- 数量极少（实测全代码节 1 个）；其余只进直方图，
                            -- 避免上一轮那样打满 300 条把扫描截断。
                            if name=='orbit' then
                                emit('callerscan;from='..string.format('%x',at)..';to=orbit')
                            end
                        end
                    end
                    i=p+1
                end
            end
            off=off+32764
        end
        local hist={}
        for _,nm in ipairs(order) do
            if counts[nm] then
                hist[#hist+1]=nm..'='..counts[nm]..'@'..string.format('%x',first[nm])
                    ..'-'..string.format('%x',last[nm])
            end
        end
        emit('callerscan_done;hits='..tostring(total)
            ..';ms='..tostring(clock and math.floor((clock()-t0)*1000) or -1)
            ..';range=1000-2110a93;hist='..table.concat(hist,','))
        -- ★★ state=4 写入点扫描（2026-10-09）：有没有**可调用的**提升函数？ ★★
        --
        --   背景（因果链已闭合，见 memory）：引擎只在"候选分数 > 0"时才置 state=4；
        --   而建筑/虫洞不在候选列表里 ⇒ 无敌人时永远进不了 state 4 ⇒ 没有引导授权。
        --
        --   ⚠ 先说清为什么不能"自己写 state=4"：本工程**没有写内存原语** ——
        --     FFI 面只有 `ReadProcessMemory`（只读）+ 5 个引擎函数
        --     （clear / orbit / aim / explode / remove）。而 `clear` 的反汇编证明
        --     它只把 80 字节记录拷进 obj+0x10、置 +0x70 标志、写 +0x68/+0x6c，
        --     **完全不碰 `[obj+8]`（state）** ⇒ 借 clear 间接获得 state 4 也不成立。
        --
        --   ⇒ 唯一剩下的可能是：机器码里存在一个**专门做提升的可调用函数**
        --     （而不是内联在 seek 函数里的那几行）。用模式扫出来：
        --       `C7 4X 08 04 00 00 00` = mov dword [reg+8], 4   （state = 4）
        --       `C7 4X 00 04 00 00 00` = mov dword [reg+0], 4   （behavior = 4）
        --     ModRM 0x40-0x47 = [reg+disp8]；`C7 /0` 是 mov r/m32, imm32。
        --   ⇒ 命中地址若**靠近某个函数开头**，就可能是我们能直接调用的提升函数；
        --     若全部落在 seek 函数体内（0xbafb0-0xbbd21），则此路不通。
        --   ⚠ 纯只读、启动一次、只打命中地址。
        local spats={{'\8\4\0\0\0','state4'},{'\0\4\0\0\0','behav4'}}
        local shits,sreads,sreads_fail=0,0,0
        local soff=0x1000
        while soff<0x2110a93 and shits<200 do
            -- ⚠ 上限必须是 32763：`read` 的断言是 `n<=32768`，而这里要 `n+5`
            --   （模式 7 字节、防跨块）。2026-10-09 我写成 `math.min(32764,…)`
            --   ⇒ 每块传 32769 ⇒ **每次读都被断言拒绝、又被 pcall 吞掉**
            --   ⇒ 整个扫描什么都没扫，却打出一行看起来完全合法的 `hits=0`
            --   ——**静默失败伪装成了结论**（本工程栽过一次，这次是第二次）。
            --   ⇒ 现在同时统计 reads / reads_fail，失败不再可能伪装成"没命中"。
            local n=math.min(32763,0x2110a93-soff)
            local ok,b=pcall(read,base+soff,n+5)
            sreads=sreads+1
            if ok then
                for _,pt in ipairs(spats) do
                    local i=1
                    while true do
                        local p=b:find(pt[1],i,true)
                        if not p then break end
                        if p>=3 and b:byte(p-1)>=0x40 and b:byte(p-1)<=0x47
                            and b:byte(p-2)==0xc7 then
                            if shits<200 then
                                shits=shits+1
                                emit('statescan;from='..string.format('%x',soff+(p-3))
                                    ..';kind='..pt[2])
                            end
                        end
                        i=p+1
                    end
                end
            else
                sreads_fail=sreads_fail+1
            end
            soff=soff+32763
        end
        emit('statescan_done;hits='..tostring(shits)..';reads='..tostring(sreads)
            ..';reads_fail='..tostring(sreads_fail))
    end
    local calls=Binding.bind_experimental(read,base)
    for _,g in ipairs(TitanProfile.engine_guards) do
        local expected=g[2]:gsub('..',function(b) return string.char(tonumber(b,16)) end)
        assert(read(exe+g[1],#expected)==expected,'Titan engine layout mismatch')
    end
    calls.target_valid=ffi.cast('bool (*)(void *, uint32_t, const void *)',base+0x8858a0)
    calls.explode=ffi.cast('void (*)(void *, uint32_t, uint32_t, void *)',base+0x8cdf80)
    calls.remove=ffi.cast('void (*)(void *, uint32_t)',base+0xfdc310)
    calls.aim=ffi.cast('void *(*)(void *, void **, const void *)',base+0x4b0c40)
    host=Runtime.new({read=read,base=base,exe=exe,calls=calls,
        -- ★ 受控写通道（2026-10-09）：只给 promote_state4 用。见 write() 的边界说明。
        write=write,
        titan_profile=TitanProfile,weakpoint_profiles=WeakpointProfiles,
        -- ★ 泰坦变体（借用基线几何）。见 compat/titan_variants.lua 的证据注释。
        titan_variant_profiles=(TitanVariants and TitanVariants.profiles) or nil,
        titan_variants_enabled=state.titan_variants_enabled,designed_targets_only=state.designed_targets_only,priority_catalog=PriorityCatalog,fuse_profile=FuseProfile,experimental_event_window=true,
        -- ★ 泰坦接管开关（2026-09-29）。false = 退回"只打虫洞"。
        titan_enabled=state.titan_enabled,
        mark_priority_enabled=state.mark_priority_enabled,exclusive_targets=state.exclusive_targets,
        structure_profiles=state.marked_structures and StructureProfiles or nil,
        -- ★ 早期接管（state 2/3）—— 开启
        --
        --   【血泪教训】2026-09-28 10:0x 之前的包里这个开关是 false，
        --   导致整条早期路径（含探测与引爆）**从未执行** —— 日志 `entered=0`
        --   就是证据。改了逻辑却忘开开关，等于交付死代码给用户测。
        --   ⇒ 交付前必须从**构建产物**里 grep 出开关值再发包。
        --
        --   两轮实验结论（引擎在 state 2/3 的导航不读目标数据）：
        --     v1 实体模式：引擎接受写入但不采纳（虫洞不是合法敌人）
        --     v2 点目标模式：写入回读完全一致，但 G-60 依然停在 state 3 上千帧
        --   实测 early_probe 距离 76.5m / 18.5m / 14.5m ⇒ 早期它纯 ballistic
        --   飘向别处，"站虫洞旁扔就能进 3.2m 圈"这个推断已被数据否掉。
        --   保留本开关是因为：一旦引擎行为变化（如某天 state 3 读 selection），
        --   这里能立刻用；关闭只需改成 false，不影响 state-4 主链路。
        --
        --   保护链（任一触发即自动退回 state-4-only，不牵连全局）：
        --     · EARLY_MIN_AGE=15：刚出膛 15 帧内不碰
        --     · check()：每次调用校验 identity + 飞行计时器
        --     · 连续 3 次 state3_danger → state3_blocked
        -- ★ 早期接管 —— **关闭**（2026-09-28 11:00 实机回归）★
        --
        -- 打开它的实测后果：日志第 2 行就出现
        --     frame_error;detail=...: pointer bound
        -- 之后 `entered=1; locked=0` 持续 300+ 帧，`priority_locked` 与
        -- `takeover_probe` **一次都没出现** —— 即完全无法接管。
        --
        -- 原因：早期路径在 state 2/3 就调用 Context.capture 取虫洞位姿，
        -- 而该路径对早期 state 未经实机验证，capture 内部指针解引用失败
        -- (`pointer bound`)。每帧 pcall 失败 ⇒ 锁定永远拿不到。
        --
        -- ⇒ **放宽断言 ≠ 整条链路可用。** 我三轮前只放宽了 state 断言就以为
        --   路径打通了，实际 capture/到达/引爆三个环节都需要各自验证。
        --   记录在此以免重蹈覆辙。
        --
        -- 两轮实验的既得结论（都不依赖本开关，保留备查）：
        --   · state 2/3 的导航**不读任何目标数据**（v1 实体模式、v2 点目标模式
        --     写入回读均一致，但 G-60 依然停在 state 3 上千帧）
        --   · 实测 early_probe 距离 76.5m / 18.5m / 14.5m
        --     ⇒ 早期纯 ballistic 飘向别处
        --   · G-60 在**飞行寿命到期（30s）时自然转入 state 4**，与敌人无关
        allow_state3=state.allow_state3,
        force_lock_enabled=state.force_lock_enabled,
        titan_standoff=state.titan_standoff,
        adaptive_approach=state.adaptive_approach,blast_regions=state.blast_regions,
        dragonroach_enabled=state.dragonroach_enabled,dragonroach_resource=state.dragonroach_resource,
        enemy_veto_enabled=state.enemy_veto_enabled,
        generic_takeover_enabled=state.generic_takeover_enabled,
        -- ★ 体内爆点名册（2026-10-03）：见 compat/blast_sites.lua 与 state 处的说明。
        --   与虫洞的"距离<4m"机制**分开**；置 false ⇒ 退回"引擎 aim"。
        blast_sites=state.blast_sites_enabled and BlastSites or nil,
        early_nav_probe=state.early_nav_probe,early_nav_orbit=state.early_nav_orbit,
        sel_probe_enabled=state.sel_probe_enabled,
        -- ★ 目标字段探针（2026-10-08）。⚠ 这里曾经漏过：开关只写进了 state、
        --   没进 env ⇒ helper 里 `env.target_fields_probe` 是 nil ⇒ 静默不触发，
        --   而当时守门只查了"开关声明"没查"接线" ⇒ 门绿功能死（实机一次抓出）。
        target_fields_probe=state.target_fields_probe,
        -- ★ code_probe_enabled 也必须进 env（2026-10-09 修）：启动时的 dump 直接读
        --   `state.code_probe_enabled` 所以一直能跑，但 `probe_record_pointers`
        --   读的是 **env** 的字段 ⇒ 没接线时静默不触发（recptr 一条都没有）。
        --   ⚠ 这是**第二次**同类事故（前一次 target_fields_probe）⇒ 本轮加了
        --     结构性守门 test_env_wiring_complete，一次覆盖所有 env 字段。
        code_probe_enabled=state.code_probe_enabled,
        ping_slot_dump=state.ping_slot_dump,
        point_marker_enabled=state.point_marker_enabled,
        point_target_enabled=state.point_target_enabled,
        point_target_ttl_frames=state.point_target_ttl_frames,
        scan_every_busy=state.scan_every_busy,scan_every_idle=state.scan_every_idle,
        unit_mark_live_only=state.unit_mark_live_only,
        structure_mark_live_only=state.structure_mark_live_only,
        marked_unit_rank_first=state.marked_unit_rank_first,
        point_arrival_region=state.point_arrival_region,
        titan_arrival_region=state.titan_arrival_region,
        -- （`titan_belly_above` 已于 2026-10-05 按上游移除，见 state 表处的说明）
        titan_animated_belly=state.titan_animated_belly,
        thread=function() return tonumber(k.GetCurrentThreadId()) end,
        engine=assert(rawget(_G,'stingray'),'engine API unavailable'),emit=emit})
    state.stop=Runtime.install(_G,host,function()
        state.filter_enabled=false;state.state='disabled';emit('disabled;applied='..host.applied);close()
    end)
    state.stats=host;state.filter_enabled=true;state.state='experimental filtering active'
    -- ★★★ 状态行**拆成三段**（2026-10-03）★★★
    --
    --   原因（实机取证，不是预防性改动）：`emit` 有 **900 字符**上限 ——
    --   见本文件 `line=tostring(line):gsub('[\r\n]',' '):sub(1,900)`。
    --   而单行状态行早就超过 1000 字符 ⇒ 2026-10-03 的日志里能看到它被
    --   **从中间切断**：
    --     `...enemy_veto_resources=74e2285c01da4f71,db90077e76`   ← 第二个哈希断在这里
    --   其后**所有**字段一个字都没写出来，包括那三个用户明确要求的开关：
    --     `unit_mark_live_only` / `structure_mark_live_only` / `marked_unit_rank_first`
    --   ⇒ 后果正是本项目的老毛病「**承诺了却看不到**」—— 那些行为用户要验证，
    --     而唯一的确认途径（版本行）里根本没有它们。
    --
    --   改法：按语义拆成 3 段（`version=` / `titan_settings;` / `mark_settings;`），
    --   每段都远低于上限；**字段名一个都不改**（已有文档/脚本按名 grep）。
    --   末尾再打一条 `status_len` **自报长度** ⇒ 将来再变长也能直接从日志看出来
    --   （> `cap` 就是被切了），而不是又一次静默截断。
    -- ★ 体内爆点（2026-10-03）：开关 + lift + **专用到达区域** 都必须在状态行可见。
    --   region 是"炸得准不准"的直接原因（爆心必须落进爆炸内半径 4 m）。
    --   ⚠ 用 **段内 IIFE** 算，不新开段外 local：
    --     ① 段外 local 会让 `test_status_line_fits_log_cap`（逐段求值那个测试）
    --        报 `attempt to concatenate a nil value`；
    --     ② 逐字段判空 —— `nil..'/'` 会当场抛错 ⇒ 又是加载期 disabled
    --        （同一天已经在 `BlastSites[...]` 上栽过一次）。
    local status_core='version=@@VERSION@@-bughole;runtime_baseline=@@RUNTIME_BASELINE@@'
        ..';build=BUGHOLE_PLUS_TITAN;scope=marked_bughole_and_bile_titan;'
        ..'bughole_profiles=16;enemy_priority=REMOVED;weakpoints=REMOVED;'
        ..'hole_variants=INCLUDED;spore_spewer_egg=REMOVED;target_valid=SOFT_SIGNAL;'
        ..'selection_veto=DISABLED;unmarked_behavior=VANILLA;filter_enabled=true;'
        ..'enemy_tracking=VANILLA_UNTOUCHED;priority_gated=STRUCTURE_ONLY;arrival_gated='
        ..(state.allow_state3 and 'STATE3_ALLOWED' or 'HELD_LOCK_ONLY')
        ..';allow_state3='..tostring(state.allow_state3)..';'
        ..'force_lock_enabled='..tostring(state.force_lock_enabled)..';'
        ..'disposal_gated=HELD_LOCK_ONLY;'
        ..'designed_targets_only='..tostring(state.designed_targets_only)..';'
        ..'mark_priority_enabled=false;exclusive_targets=true;marked_structures=true;'
        ..'native_lifetime_verified=false;mode=EXPERIMENTAL_NATIVE_CALLS'
        -- ★ 2026-10-03：观测节流周期必须可见 —— "看不到就等于无法确认"（本工程老毛病）
        ..';scan_every_busy='..tostring(state.scan_every_busy)
        ..';scan_every_idle='..tostring(state.scan_every_idle)
    local status_titan='titan_settings;titan_standoff='..state.titan_standoff
        ..';titan_arrival_radius='..state.titan_arrival_region.radius..';titan_arrival_depth='..state.titan_arrival_region.depth
        ..";adaptive_approach="..tostring(state.adaptive_approach)..";blast_regions="..tostring(state.blast_regions)
        -- ★ 腹部提前引爆余量（2026-10-02）：必须能在日志里一眼确认它是否生效 ——
        --   0 = 旧行为（必须到爆点或更低）
        -- （`titan_belly_above` 已移除；泰坦爆点改由 Adaptive 决定）
        -- ★ 泰坦模板整合开关（2026-10-04）：必须一眼能看到它是否生效
        ..';titan_animated_belly='..tostring(state.titan_animated_belly)
        ..';dragonroach_enabled='..tostring(state.dragonroach_enabled)
        ..';dragonroach_resource='..tostring(state.dragonroach_resource)
        ..';titan_variants_enabled='..tostring(state.titan_variants_enabled)
        ..';generic_takeover_enabled='..tostring(state.generic_takeover_enabled)
        -- ★ 2026-10-03：体内爆点开关 + 实际抬升量必须可见 ——
        --   "看不到就等于无法确认它到底生效了没有"（本工程老毛病），
        --   而它是唯一需要实机标定的量（改 lift 要能一眼看到日志里变了）。
        ..';blast_sites='..tostring(state.blast_sites_enabled)
        -- ★ 段内 IIFE：lift + 专用 region（逐字段判空，绝不 `nil..'/'`）
        --   ★ 2026-10-03 追加 `blast_sweep`：标定档位表。**必须在状态行可见** ——
        --   "扫高度的这一局到底扫了哪些档"是判读日志的前提，看不到就只能猜。
        ..(function()
            local s=BlastSites and BlastSites["4232ee48e2cfd24e"]
            if not s then return ';blast_site_lift=nil;blast_site_region=none' end
            local r=s.region
            local sw='off'
            local sc=BlastSites and BlastSites.scan
            if type(sc)=='table' and #sc>0 then sw=table.concat(sc,'/') end
            return ';blast_site_lift='..tostring(s.lift)
                ..';blast_site_region='..(
                    (r and r.radius and r.depth and r.above)
                    and (r.radius..'/'..r.depth..'/'..r.above) or 'default')
                ..';blast_sweep='..sw
        end)()
        -- ★ 引擎选择否决：开关 + 实际排除的资源，便于日志确认是否生效
        ..';enemy_veto_enabled='..tostring(state.enemy_veto_enabled)
        -- ★ 必须从 Filter.excluded_resources() 派生，**不得硬编码哈希**：
        --   2026-09-29 就是这里硬编码了旧哈希(98152772a72f7838)，
        --   而实现里已换成 db90077e76faa025 ⇒ 日志与实现不一致，核对时被骗。
        ..';enemy_veto_resources='..table.concat(Filter.excluded_resources(),',')
        ..';titan_variants='..table.concat(TitanVariants and TitanVariants.resources() or {},',')
        -- ★ 2026-09-29：接管范围 = 标记虫洞 + 吐酸泰坦，其余交还引擎。
        --   titan_resource 打出实际哈希，方便日志确认是否命中预期目标。
        ..';titan_enabled='..tostring(state.titan_enabled)
        ..';titan_resource='..tostring(TitanProfile and TitanProfile.resource)
    -- ★ 2026-10-01 优先级（用户定：虫洞/构筑 > 标记单位 > 空白标记）
    --   单位标记的记忆判据 —— 打出来才能确认"取消标记后不再追"这一条有没有生效。
    --   ★ 2026-10-03：**必须带 `marked_unit_rank_first`** —— 标记队列的档位排序开关，
    --     用户要求的功能，日志里看不到就无法确认（它此前正是被 900 截断切掉的那个）。
    local status_marks='mark_settings;unit_mark_live_only='..tostring(state.unit_mark_live_only)
        ..';structure_mark_live_only='..tostring(state.structure_mark_live_only)
        ..';marked_unit_rank_first='..tostring(state.marked_unit_rank_first)
    emit(status_core);emit(status_titan);emit(status_marks)
    emit('status_len;core='..#status_core..';titan='..#status_titan
        ..';marks='..#status_marks..';cap=900')
end)
if not ok then
    state.filter_enabled=false;state.state='disabled: '..tostring(why)
    if log then pcall(function() log:write(state.state..'\n') end) end
    close()
end
print('[G60BugholeLock] '..state.state)
return state
